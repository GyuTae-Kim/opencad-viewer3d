{
  "name": "opencad-viewer3d",
  "version": "0.23.0",
  "private": true,
  "description": "OpenCAD 3D 뷰어 코어: 브라우저에서 WebGL2로 3D 장면(Scene3d)을 그리고 고르고 재는 뷰어",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "vite --open /dev/viewer3d.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pixels": "node scripts/pixels/run.mjs",
    "bench:edit": "node scripts/bench/edit.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
